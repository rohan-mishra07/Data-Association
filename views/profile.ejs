<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-zinc-900 text-white min-h-screen p-10">
    <div class="w-full flex justify-end">
        <a href="/logout" class="bg-red-500 hover:bg-red-600 px-3 py-2 text-sm rounded-md mb-5 inline-block">Logout</a>
    </div>

    <div class="flex items-center gap-3">
        <!-- Clickable Profile Picture Link -->
        <a href="/profile/upload" title="Change Profile Picture" class="block h-12 w-12 rounded-md overflow-hidden border border-zinc-700 hover:border-blue-500 hover:opacity-80 transition cursor-pointer">
            <img class="h-full w-full object-cover" 
                 src="<%= (user.profilepic && user.profilepic !== 'default.png') ? user.profilepic : 'https://api.dicebear.com/7.x/identicon/svg?seed=' + user.username %>" 
                 alt="Profile Picture"
                 onerror="this.onerror=null;this.src='https://api.dicebear.com/7.x/identicon/svg?seed=<%= user.username %>';">
        </a>
        <h3 class="text-3xl"><span class="font-light">Hello</span>, <%= user.name %> 👋</h3>
    </div>
    
    <div class="mt-3 text-zinc-400 space-y-1">
        <p><span class="text-zinc-200 font-medium">Username:</span> <%= user.username %></p>
        <p><span class="text-zinc-200 font-medium">Email:</span> <%= user.email %></p>
        <p><span class="text-zinc-200 font-medium">Age:</span> <%= user.age %></p>
    </div>

    <h5 class="mt-8 mb-2 text-zinc-300">Create a new post:</h5>
    <form method="POST" action="/post" class="w-1/3">
        <textarea placeholder="What's on your mind?" class="p-3 outline-none w-full resize-none bg-transparent border-2 border-zinc-700 rounded-md block text-white" name="content" rows="3" required></textarea>
        <input class="px-3 py-2 bg-blue-500 hover:bg-blue-600 block rounded-md mt-2 cursor-pointer text-sm font-medium" type="submit" value="Create Post">
    </form>

    <div class="posts mt-10">
        <h3 class="text-zinc-300 text-xl mb-4 font-semibold">Your Posts</h3>
        <div class="postcontainer flex flex-wrap gap-4">
            <% if (user.posts && user.posts.length > 0) { %>
                <% user.posts.slice().reverse().forEach(function(post) { %>
                    <div class="post w-80 p-4 rounded-md border border-zinc-700 bg-zinc-800">
                        <h4 class="text-blue-400 mb-2 font-medium">@<%= user.username %></h4>
                        <p class="text-sm tracking-tight text-zinc-200 mb-3"><%= post.content %></p>
                        <small class="mt-1 inline-block"><%= post.likes ? post.likes.length : 0 %></small>
                        <div class="btns flex gap-5 mt-3 mb-3 text-sm">
                            <a class="text-blue-500" href="/like/<%= post._id %>">
                                <%= post.likes.indexOf(user._id) === -1 ? "Like" : "Unlike" %>
                            </a>
                            <a class="text-zinc-400 hover:text-zinc-200" href="/edit/<%= post._id %>">Edit</a>
                            <a class="text-red-500 hover:text-red-400" href="/delete/<%= post._id %>" onclick="return confirm('Are you sure you want to delete this post?');">Delete</a>
                        </div>

                        <div class="text-xs text-zinc-400 flex justify-between items-center">
                            <span><%= post.date ? new Date(post.date).toLocaleDateString() : '' %></span>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p class="text-zinc-500">No posts yet.</p>
            <% } %>
        </div>
    </div>
</body>
</html>