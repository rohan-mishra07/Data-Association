<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-zinc-900 text-white min-h-screen p-10">
    <div class="w-full">
        <h3 class="text-3xl mb-5">Upload File</h3>
        <form autocomplete="off" action="/upload" method="POST" class="flex flex-col gap-3 w-72" enctype="multipart/form-data">
            <input type="file" name="image" required>
            <button class="px-3 py-2 outline-none bg-blue-500 text-white rounded-md cursor-pointer hover:bg-blue-600" type="submit">Upload File</button>
        </form>
    </div>
</body>
</html>