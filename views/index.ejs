<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
      <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <h7 class="text-3xl mb-5">Create Account</h7>
    <form action="/register" method="post">
        <input class="px-3 py-2 outline-none bg-transparent border-2 border-zinc-600 rounded-md" type="text" name="name" placeholder="Name" class="w-full p-2 rounded-md bg-zinc-800 text-white">
        <input class="px-3 py-2 outline-none bg-transparent border-2 border-zinc-600 rounded-md" type="text" name="email" placeholder="email" class="w-full p-2 rounded-md bg-zinc-800 text-white">
        <input class="px-3 py-2 outline-none bg-transparent border-2 border-zinc-600 rounded-md" type="password" name="password" placeholder="password" class="w-full p-2 rounded-md bg-zinc-800 text-white">
        <input class="px-3 py-2 outline-none bg-transparent border-2 border-zinc-600 rounded-md" type="text" name="username" placeholder="username" class="w-full p-2 rounded-md bg-zinc-800 text-white">
        <input class="px-3 py-2 outline-none bg-transparent border-2 border-zinc-600 rounded-md" type="number" name="age" placeholder="age" class="w-full p-2 rounded-md bg-zinc-800 text-white">
        <button class="px-3 py-2 outline-none bg-blue-500 text-white rounded-md" type="submit" class="w-full p-2 rounded-md">Submit</button>
    </form>
    </div>
</body>
</html>