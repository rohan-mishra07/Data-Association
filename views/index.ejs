<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-zinc-900 text-white min-h-screen p-10">
    <div class="w-full">
        <h3 class="text-3xl mb-5">Create Account</h3>
        <form action="/register" method="POST" class="flex flex-col gap-3 w-72">
            <input class="px-3 py-2 outline-none bg-transparent border-2 border-zinc-600 rounded-md" type="text" name="name" placeholder="Name" required>
            <input class="px-3 py-2 outline-none bg-transparent border-2 border-zinc-600 rounded-md" type="text" name="username" placeholder="Username" required>
            <input class="px-3 py-2 outline-none bg-transparent border-2 border-zinc-600 rounded-md" type="email" name="email" placeholder="Email" required>
            <input class="px-3 py-2 outline-none bg-transparent border-2 border-zinc-600 rounded-md" type="password" name="password" placeholder="Password" required>
            <input class="px-3 py-2 outline-none bg-transparent border-2 border-zinc-600 rounded-md" type="number" name="age" placeholder="Age" required>
            <button class="px-3 py-2 outline-none bg-blue-500 text-white rounded-md cursor-pointer hover:bg-blue-600" type="submit">Create Account</button>
        </form>
        <p class="mt-4 text-zinc-400 text-sm">Already have an account? <a href="/login" class="text-blue-400 hover:underline">Login here</a></p>
    </div>
</body>
</html>